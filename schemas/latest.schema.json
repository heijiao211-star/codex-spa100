{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fund report latest.json",
  "type": "object",
  "required": ["schema_version", "report_generated_at", "report_timezone", "report_status", "funds"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "report_generated_at": {"type": "string"},
    "report_timezone": {"const": "Asia/Shanghai"},
    "report_status": {"enum": ["OK", "DEGRADED", "FAILED"]},
    "funds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["identity", "official_nav", "subscription", "estimate", "performance", "warnings", "provenance"],
        "properties": {
          "identity": {"type": "object", "required": ["code", "official_name", "platform"]},
          "official_nav": {"type": "object", "required": ["nav_date", "unit_nav", "daily_return", "source"]},
          "subscription": {"type": "object", "required": ["official_account_limit", "alipay_verified_limit", "status"]},
          "estimate": {"type": "object", "required": ["estimated_return", "is_official", "source"]}
        }
      }
    }
  }
}

